# ==============================
# App
# ==============================
NODE_ENV=development
PORT=5000
APP_NAME=Diaspora Legal
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ==============================
# Database (MySQL / Sequelize)
# ==============================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diaspora_legal
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_LOGGING=false

# ==============================
# JWT / Auth
# ==============================
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=
BCRYPT_SALT_ROUNDS=10

# ==============================
# Mail (Nodemailer)
# ==============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Diaspora Legal
MAIL_FROM_ADDRESS=no-reply@diasporalegal.com

# ==============================
# File Uploads (Multer)
# ==============================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ==============================
# Socket.io
# ==============================
SOCKET_CORS_ORIGIN=http://localhost:3000

# ==============================
# Payments
# ==============================
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
